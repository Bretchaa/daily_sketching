<% content_for :head do %>
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="<%= root_url %>">
<% end %>

<div class="challenge-page bg-paper min-h-screen flex items-center justify-center px-4 py-10">
  <div class="w-full" style="max-width: 52rem;">

    <div class="bg-white rounded-[2rem] overflow-hidden" style="border: 2px solid #1a1a1a;">

      <%# Body: details + example image %>
      <div class="challenge-body" style="display: flex; align-items: stretch;">

        <%# Left: details %>
        <div style="flex: 1; padding: 2.5rem 3rem; display: flex; flex-direction: column; gap: 2rem;">

          <div>
            <p class="font-sans" style="font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #bbb; margin-bottom: 0.4rem;">Today's challenge <span style="font-weight: 400; text-transform: none; letter-spacing: 0; color: #ccc;">· <%= Date.current.strftime("%A, %B %-d") %></span></p>
            <h1 class="font-handwritten" style="font-size: 2.25rem; color: #1a1a1a; line-height: 1.1;"><%= @theme_config["display_name"] %></h1>
          </div>

          <div>
            <p class="font-handwritten" style="font-size: 1.1rem; color: #1a1a1a; margin-bottom: 0.2rem;">Focus</p>
            <p class="font-sans" style="font-size: 1rem; color: #2a2a2a; line-height: 1.6;"><%= @theme_config["focus"] %></p>
          </div>

          <div>
            <p class="font-handwritten" style="font-size: 1.1rem; color: #1a1a1a; margin-bottom: 0.2rem;">Tip</p>
            <p class="font-sans" style="font-size: 1rem; color: #2a2a2a; line-height: 1.6;"><%= @theme_config["tip"] %></p>
          </div>

          <div>
            <p class="font-handwritten" style="font-size: 1.1rem; color: #1a1a1a; margin-bottom: 0.4rem;">Exercise</p>
            <% format_duration = ->(s) { s == 0 ? "no timer" : s < 60 ? "#{s}s" : "#{s / 60} min" } %>
            <% if @theme_config["stages"] %>
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
                <% @theme_config["stages"].each_with_index do |stage, i| %>
                  <span class="font-sans" style="background: #1a1a1a; border-radius: 0.4rem; padding: 0.3rem 0.9rem; font-size: 0.875rem; color: #fff; font-weight: 600;"><%= stage["count"] %> × <%= format_duration.call(stage["duration_seconds"]) %></span>
                  <% if i < @theme_config["stages"].size - 1 %>
                    <span style="color: #1a1a1a;">→</span>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <span class="font-sans" style="background: #1a1a1a; border-radius: 0.4rem; padding: 0.3rem 0.9rem; font-size: 0.875rem; color: #fff; font-weight: 600;"><%= @theme_config["poses_count"] %> poses · <%= format_duration.call(@theme_config["duration_seconds"]) %> each</span>
            <% end %>
          </div>

          <% if @theme_config["resource_url"].present? %>
            <div>
              <p class="font-handwritten" style="font-size: 1.1rem; color: #1a1a1a; margin-bottom: 0.2rem;">Learn</p>
              <%= link_to @theme_config["resource_label"], @theme_config["resource_url"], target: "_blank", rel: "noopener", class: "font-sans", style: "font-size: 0.95rem; color: #1a1a1a; font-weight: 600; text-decoration: underline; text-underline-offset: 3px;" %>
            </div>
          <% end %>

          <p class="font-sans" style="font-size: 1rem; color: #2a2a2a; line-height: 1.6;">Grab a sheet of paper and a pencil, and have fun!</p>

        </div>

        <%# Right: example image — full image visible, contained in column %>
        <% if @theme_config["example_image_url"].present? %>
          <div class="challenge-image-panel" style="width: 18rem; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 2rem 2rem 0; gap: 0.5rem;">
            <span class="img-skeleton" style="display: block; border-radius: 1rem; min-height: 12rem; width: 100%;">
              <img src="<%= @theme_config["example_image_url"] %>"
                   alt="Example drawing"
                   fetchpriority="high"
                   style="max-width: 100%; max-height: 100%; width: auto; height: auto; border-radius: 1rem; object-fit: contain; display: block;"
                   onload="this.parentElement.classList.remove('img-skeleton')" />
            </span>
          </div>
        <% end %>

      </div>

      <%# CTA — full width, sticky on mobile %>
      <div class="challenge-cta" style="padding: 0 2.5rem 2.5rem;">
        <% if @theme_config["skip_session"] %>
          <%= link_to "Upload my sketch", done_path, class: "btn-sketchy", style: "width: 100%;" %>
        <% else %>
          <%= link_to "Start drawing", draw_path(step: 1), class: "btn-sketchy", style: "width: 100%;" %>
        <% end %>
      </div>

    </div>
  </div>
</div>

<style>
  @media (max-width: 600px) {
    .challenge-body { flex-direction: column !important; }
    .challenge-image-panel { width: 100% !important; padding: 0 2rem 1rem !important; }
    .challenge-page { padding-top: 4.75rem !important; padding-bottom: 6rem !important; }
    .challenge-cta {
      position: fixed !important;
      bottom: 0; left: 0; right: 0;
      padding: 4rem 1.25rem 1.75rem !important;
      background: linear-gradient(to bottom, transparent, #f5f2ee 40%);
      z-index: 10;
    }
  }
</style>
