<h2>Daily Sketching — <%= Date.yesterday.strftime("%B %-d, %Y") %></h2>

<h3>Users</h3>
<p><strong>Total users:</strong> <%= @total_users %></p>

<% if @new_users.any? %>
  <p><strong><%= @new_users.count %> new <%= @new_users.count == 1 ? "user" : "users" %> yesterday:</strong></p>
  <ul>
    <% @new_users.each do |user| %>
      <li><%= user.email %> (<%= user.username %>)</li>
    <% end %>
  </ul>
<% else %>
  <p>No new users yesterday.</p>
<% end %>

<h3>Drawings</h3>
<p><strong>Submissions yesterday:</strong> <%= @submissions_yesterday %></p>
<p><strong>Total submissions:</strong> <%= @total_submissions %></p>
