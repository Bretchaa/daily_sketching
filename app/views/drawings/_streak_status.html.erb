<% if @streak > 0 %>
  <div style="display: flex; align-items: center; justify-content: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #f9f4e8; border-radius: 999px; padding: 0.45rem 1rem;">
      <div style="width: 1.6rem; height: 2rem; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
        <svg viewBox="0 0 36 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: 100%; filter: drop-shadow(0 2px 6px rgba(255,212,0,0.5));">
          <path d="M24 2L4 26L15 26L11 46L32 22L21 22Z" fill="#FFD400"/>
        </svg>
      </div>
      <span class="font-sans" style="font-size: 0.82rem; font-weight: 700; color: #1a1a1a;"><%= @streak %> day streak</span>
    </div>

    <% if @show_shield_pill %>
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #f9f4e8; border-radius: 999px; padding: 0.45rem 1rem;">
        <div style="width: 1.6rem; height: 2rem; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 1.5rem; height: 1.5rem; filter: drop-shadow(0 2px 6px rgba(20,184,166,0.55));">
            <path d="M3 12.5C3 7.3 7 3 12 3C17 3 21 7.3 21 12.5H3Z" fill="#14B8A6"/>
            <rect x="11.3" y="12.5" width="1.4" height="6.5" fill="#14B8A6"/>
            <path d="M11.3 19C11.3 19 9.6 19 9.6 17.4" stroke="#14B8A6" stroke-width="1.3" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
        <span class="font-sans" style="font-size: 0.82rem; font-weight: 700; color: #1a1a1a;">
          <% if @shields_earned.to_i > 0 %>
            +1 shield
          <% else %>
            A streak shield saved your streak!
          <% end %>
        </span>
      </div>
    <% end %>
  </div>
<% end %>
