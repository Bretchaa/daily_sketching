<style>
  @media (max-width: 640px) {
    .hero-split { flex-direction: column !important; min-height: unset !important; }
    .hero-split .hero-left { padding: 3.5rem 1.75rem 3rem !important; align-items: center !important; text-align: center !important; }
    .hero-split .hero-left p { margin-bottom: 2.5rem !important; }
    .hero-split .hero-left .shield-pill-row p { margin-bottom: 0 !important; }
    .hero-split .hero-left .shield-pill-row { flex-wrap: nowrap !important; }
    .hero-split .hero-left .shield-pill { padding: 0.75rem 0.9rem !important; }
    .hero-split .hero-left h1 { margin-bottom: 1.25rem !important; }
    .hero-split .hero-headline { font-size: 2.1rem !important; }
    .hero-split .hero-cta { width: 100% !important; justify-content: center; }
    .hero-split .hero-right { border-left: none !important; padding: 0 1.75rem 3rem !important; height: 260px !important; }
    .hero-cta-group { flex-direction: column !important; width: 100% !important; align-items: stretch !important; }
    .hero-cta-group .btn-secondary { width: 100% !important; justify-content: center !important; }
    .hero-cta-group .btn { width: 100% !important; justify-content: center !important; }
    .hero-cta-group .btn-sketchy { width: 100% !important; justify-content: center !important; }
    .hero-cta-group .btn-sketchy-secondary { width: 100% !important; justify-content: center !important; }
    .btn-sketchy.hero-cta { width: 100% !important; justify-content: center !important; }
  }
  @keyframes bounce-down {
    0%, 100% { transform: translateX(-0.15em) translateY(-0.15em); }
    50% { transform: translateX(-0.15em) translateY(calc(-0.15em + 6px)); }
  }
</style>

<%= render "shared/lightbox" %>

<% show_scroll_hint = @yesterday_count >= 5 %>

<div class="bg-paper">

  <%# Hero — split layout %>
  <div class="hero-split" style="min-height: 100vh; display: flex; align-items: stretch; position: relative;">

    <%# Left — CTA %>
    <div class="hero-left" style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 2rem 3rem 6rem 5rem; min-width: 0;">

      <%= image_tag "logo_home.svg", class: "hero-logo", style: "height: 7.5rem; width: auto; margin-bottom: 3.5rem; display: block;", alt: "Daily Sketching" %>

      <% if current_user %>
        <h1 class="font-handwritten hero-headline" style="font-size: 2.75rem; line-height: 1.15; color: #1a1a1a; margin-bottom: 0.75rem;">
          <% if @drew_today || @completed_not_uploaded %>
            Well done,<% if current_user.username.length > 10 %><br><% end %> <%= current_user.username %>!
          <% else %>
            Welcome back,<% if current_user.username.length > 10 %><br><% end %> <%= current_user.username %>
          <% end %>
        </h1>
        <p class="font-sans" style="font-size: 1rem; color: #888; margin-bottom: 2rem; line-height: 1.6;">
          <%= (@drew_today || @completed_not_uploaded) ? "Come back tomorrow for a new challenge, or keep drawing today." : "Your daily challenge is waiting." %>
        </p>

        <% if @shield_holding_streak %>
          <div class="shield-pill-row" style="display: flex; align-items: stretch; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem;">
            <div class="shield-pill" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex: 1 1 0; min-width: 0; background: #ffffff; border-radius: 1rem; padding: 1rem 1.2rem;">
              <svg viewBox="0 0 36 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 1.65rem; height: 2.2rem; flex-shrink: 0; filter: drop-shadow(0 1px 4px rgba(255,212,0,0.6));">
                <path d="M24 2L4 26L15 26L11 46L32 22L21 22Z" fill="#FFD400"/>
              </svg>
              <span class="font-sans" style="font-weight: 700; color: #1a1a1a; font-size: 1rem;"><%= @streak %> day streak</span>
            </div>

            <div class="shield-pill" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex: 1 1 0; min-width: 0; background: #ffffff; border-radius: 1rem; padding: 1rem 1.2rem;">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 1.8rem; height: 1.8rem; flex-shrink: 0; filter: drop-shadow(0 2px 6px rgba(20,184,166,0.55));">
                <path d="M3 12.5C3 7.3 7 3 12 3C17 3 21 7.3 21 12.5H3Z" fill="#14B8A6"/>
                <rect x="11.3" y="12.5" width="1.4" height="6.5" fill="#14B8A6"/>
                <path d="M11.3 19C11.3 19 9.6 19 9.6 17.4" stroke="#14B8A6" stroke-width="1.3" stroke-linecap="round" fill="none"/>
              </svg>
              <span class="font-sans" style="font-weight: 700; color: #1a1a1a; font-size: 1rem;">−1 shield (<%= @shields_count %>/<%= @shield_cap %>)</span>
            </div>
          </div>
        <% end %>
      <% else %>
        <h1 class="font-handwritten hero-headline" style="font-size: 2.75rem; line-height: 1.15; color: #1a1a1a; margin-bottom: 0.75rem;">
          One drawing challenge,<br>every day.
        </h1>
        <p class="font-sans" style="font-size: 1rem; color: #888; margin-bottom: 2rem; line-height: 1.6;">
          15 minutes of real reference drawing every day. Figures, portraits, gestures. One shared challenge. Then see what everyone drew.
        </p>
      <% end %>

      <% if @drew_today %>
        <div class="hero-cta-group" style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 1rem; align-items: center;">
          <%= link_to "See today's drawings", done_path, class: "btn-sketchy hero-cta" %>
          <%= link_to "Keep practicing", practice_path, class: "btn-sketchy-secondary hero-cta" %>
        </div>
      <% elsif @completed_not_uploaded %>
        <div class="hero-cta-group" style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 1rem; align-items: center;">
          <%= link_to "Upload your drawing", done_path, class: "btn-sketchy hero-cta" %>
          <%= link_to "Keep practicing", practice_path, class: "btn-sketchy-secondary hero-cta" %>
        </div>
      <% else %>
        <%= link_to "Start today's challenge", today_challenge_path, class: "btn-sketchy hero-cta" %>
      <% end %>

    </div>

    <%# Right — always example images %>
    <% if @example_images.present? %>
      <div class="hero-right" style="flex: 1; padding: 2.5rem 1.5rem 2.5rem 0.75rem; display: flex; flex-direction: column; min-width: 0; overflow: hidden; height: 100vh;">
        <div style="flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr); gap: 0.4rem;">
          <% @example_images.first(6).each do |url| %>
            <div class="img-skeleton" style="position: relative; border-radius: 1rem; overflow: hidden; background: #e8e3db; min-height: 0; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
              <img src="<%= url %>" style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" onload="this.parentElement.classList.remove('img-skeleton')">
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Gradient fade + scroll hint %>
    <% if show_scroll_hint %>
      <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 8rem; background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.45) 50%, white); pointer-events: none;"></div>
      <a href="#yesterday-gallery" style="position: absolute; bottom: 1.5rem; left: 5rem; display: flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; background: white; border-radius: 999px; border: 2px solid #1a1a1a; box-shadow: 0.25em 0.25em 0 #1a1a1a; text-decoration: none; animation: bounce-down 2.4s ease-in-out infinite;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </a>
    <% end %>

  </div>

  <%# Yesterday gallery %>
  <% if show_scroll_hint %>
    <div id="yesterday-gallery" style="background: white;">
    <div style="max-width: 52rem; margin: 0 auto; padding: 4rem 2rem 0;">
      <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.35rem;">
        <h2 class="font-handwritten" style="font-size: 2rem; color: #1a1a1a;">
          <%= @gallery_date == Date.yesterday ? "Yesterday's drawings" : @gallery_date.strftime("%B %-d") %>
        </h2>
        <% if @yesterday_count > 8 %>
          <%= link_to "See all", gallery_path(date: @gallery_date.to_s), class: "font-sans", style: "font-size: 0.78rem; font-weight: 600; color: #aaa; text-decoration: none;" %>
        <% end %>
      </div>
      <p class="font-sans" style="font-size: 0.85rem; color: #aaa; margin-bottom: 2rem;">
        <%= @yesterday_count %> <%= @yesterday_count == 1 ? "person" : "people" %> drew<% if @yesterday_theme.present? %> · <%= @yesterday_theme.humanize %><% end %>
      </p>

      <div style="columns: 2; column-gap: 0.75rem;">
        <% @yesterday_submissions.each do |submission| %>
          <% meta = "#{@gallery_date.strftime("%b %-d")} · #{@yesterday_theme.humanize}" %>
          <div data-lightbox
               data-img="<%= url_for(submission.image) %>"
               data-username="<%= submission.user.username %>"
               data-avatar-url="<%= submission.user.avatar_url.to_s %>"
               data-note="<%= submission.note.to_s %>"
               data-meta="<%= meta %>"
               class="img-skeleton"
               style="break-inside: avoid; margin-bottom: 0.75rem; position: relative; border-radius: 1rem; overflow: hidden; background: #e8e3db; box-shadow: 0 2px 8px rgba(0,0,0,0.08); cursor: pointer;">
            <%= image_tag url_for(submission.image), style: "width: 100%; height: auto; display: block;", loading: "lazy", onload: "this.parentElement.classList.remove('img-skeleton')" %>
            <div class="gallery-hover-overlay"></div>
          </div>
        <% end %>
      </div>

      <div style="text-align: center; padding: 5rem 0 4rem;">
        <% if @drew_today %>
          <%= link_to "See today's drawings", done_path, class: "btn-sketchy" %>
        <% elsif @completed_not_uploaded %>
          <%= link_to "Upload your drawing", done_path, class: "btn-sketchy" %>
        <% else %>
          <%= link_to "Start today's challenge", today_challenge_path, class: "btn-sketchy" %>
        <% end %>
      </div>

    </div>
    <div style="height: 4rem; background: linear-gradient(to bottom, white, rgba(245,242,238,0.5) 50%, #f5f2ee);"></div>
    </div>
  <% end %>

</div>
