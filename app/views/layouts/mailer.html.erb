<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { margin: 0; padding: 0; background-color: #f5f2ee; font-family: Arial, sans-serif; -webkit-font-smoothing: antialiased; }
      .wrapper { width: 100%; background-color: #f5f2ee; padding: 40px 16px 56px; box-sizing: border-box; }
      .wordmark { text-align: center; margin-bottom: 20px; }
      .wordmark span { font-family: 'Comic Sans MS', 'Comic Sans', Arial, sans-serif; font-size: 20px; color: #aaa; letter-spacing: 0.01em; }
      .card { max-width: 500px; margin: 0 auto; background: #ffffff; border-radius: 24px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.07); }
      .body { padding: 48px 44px 36px; }
      .footer { padding: 0 44px 36px; text-align: center; }
      h1 { font-family: 'Comic Sans MS', 'Comic Sans', Arial, sans-serif; font-size: 32px; color: #1a1a1a; margin: 0 0 28px; line-height: 1.2; }
      p { font-size: 15px; color: #666; line-height: 1.75; margin: 0 0 14px; }
      .btn { display: inline-block; background: #1a1a1a; color: #ffffff !important; text-decoration: none; font-family: Arial, sans-serif; font-size: 15px; font-weight: 600; padding: 15px 36px; border-radius: 999px; margin: 10px 0 20px; }
      .btn-wrap { text-align: center; }
      .divider { border: none; border-top: 1px solid #f0ece8; margin: 20px 0 20px; }
      .small { font-size: 12px; color: #ccc; line-height: 1.6; margin: 0; }
      .small a { color: #ccc; text-decoration: underline; }
      @media (max-width: 540px) {
        .body { padding: 36px 28px 24px; }
        .footer { padding: 0 28px 28px; }
        h1 { font-size: 26px; }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <div class="body">
          <%= yield %>
        </div>
        <div class="footer">
          <hr class="divider">
          <img src="https://assets.dailysketching.app/brand/logo_email.png" alt="Daily Sketching" style="height: 20px; width: auto; margin-bottom: 12px; opacity: 0.5;">
          <p class="small">One drawing challenge, every day.</p>
          <% if @user&.unsubscribe_token %>
            <p class="small" style="margin-top: 6px;"><a href="<%= unsubscribe_url(token: @user.unsubscribe_token) %>">Unsubscribe</a> from these emails.</p>
          <% end %>
        </div>
      </div>
    </div>
  </body>
</html>
