<%= render "shared/lightbox" %>

<div style="display: flex; flex-direction: column; min-height: 100vh;">

  <%# Profile header — white %>
  <div style="background: white;">
    <div style="padding: 5rem 1.5rem 2rem; text-align: center;">

      <%# Avatar %>
      <% if current_user.avatar_url.present? %>
        <span class="img-skeleton" style="display: block; width: 5rem; height: 5rem; border-radius: 999px; border: 3px solid white; box-shadow: 0 2px 12px rgba(0,0,0,0.12); margin: 0 auto 1rem;">
          <img src="<%= current_user.avatar_url %>" style="width: 100%; height: 100%; border-radius: 999px; display: block; object-fit: cover;" fetchpriority="high" onload="this.parentElement.classList.remove('img-skeleton')">
        </span>
      <% else %>
        <div style="width: 5rem; height: 5rem; border-radius: 999px; background: #1a1a1a; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
          <span class="font-sans" style="color: white; font-weight: 700; font-size: 1.5rem;"><%= current_user.username[0].upcase %></span>
        </div>
      <% end %>

      <%# Username + settings/back %>
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
        <h1 class="font-handwritten" style="font-size: 1.75rem; color: #1a1a1a; line-height: 1;"><%= current_user.username %></h1>
        <% if @tab == "settings" %>
          <%= link_to account_path, style: "color: #1a1a1a; text-decoration: none; display: flex; align-items: center;" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          <% end %>
        <% else %>
          <%= link_to account_path(tab: "settings"), style: "color: #1a1a1a; text-decoration: none; display: flex; align-items: center;" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
          <% end %>
        <% end %>
      </div>

      <%# Stats %>
      <div style="display: flex; justify-content: center; gap: 2.5rem;">
        <div style="text-align: center;">
          <p class="font-sans" style="font-size: 1.25rem; font-weight: 700; color: #1a1a1a; line-height: 1;"><%= @submissions.size %></p>
          <p class="font-sans" style="font-size: 0.7rem; color: #aaa; margin-top: 0.2rem;">drawings</p>
        </div>
        <div style="text-align: center;">
          <div style="display: flex; align-items: center; gap: 0.3rem; justify-content: center;">
            <svg viewBox="0 0 36 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 1rem; height: 1.3rem; filter: drop-shadow(0 2px 6px rgba(255,212,0,0.5));">
              <path d="M24 2L4 26L15 26L11 46L32 22L21 22Z" fill="#FFD400"/>
            </svg>
            <p class="font-sans" style="font-size: 1.25rem; font-weight: 700; color: #1a1a1a; line-height: 1;"><%= @streak %></p>
          </div>
          <p class="font-sans" style="font-size: 0.7rem; color: #aaa; margin-top: 0.2rem;">day streak</p>
        </div>
      </div>

    </div>
    <div style="border-top: 2px solid #1a1a1a;"></div>
  </div>

  <%# Content — dot grid paper %>
  <div class="bg-paper" style="flex: 1; padding: 2rem 1.5rem 6rem;">
    <div style="max-width: 52rem; margin: 0 auto;">

      <% if @tab == "settings" %>

        <div style="max-width: 28rem; margin: 0 auto;">
          <div style="background: white; border-radius: 1.5rem; padding: 1.5rem; border: 2px solid #1a1a1a; margin-bottom: 1rem;">
            <p class="font-sans" style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #aaa; margin-bottom: 1rem;">Profile</p>
            <div style="display: flex; flex-direction: column; gap: 0.6rem;">
              <div style="display: flex; justify-content: space-between;">
                <span class="font-sans" style="font-size: 0.875rem; color: #aaa;">Username</span>
                <span class="font-sans" style="font-size: 0.875rem; color: #1a1a1a; font-weight: 600;"><%= current_user.username %></span>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span class="font-sans" style="font-size: 0.875rem; color: #aaa;">Email</span>
                <span class="font-sans" style="font-size: 0.875rem; color: #1a1a1a;"><%= current_user.email %></span>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span class="font-sans" style="font-size: 0.875rem; color: #aaa;">Joined</span>
                <span class="font-sans" style="font-size: 0.875rem; color: #1a1a1a;"><%= current_user.created_at.strftime("%B %Y") %></span>
              </div>
            </div>
          </div>

          <div style="background: white; border-radius: 1.5rem; padding: 1.5rem; border: 2px solid #1a1a1a; margin-bottom: 1rem;">
            <p class="font-sans" style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #aaa; margin-bottom: 1rem;">Session</p>
            <%= button_to "Sign out", sign_out_path, method: :delete,
                  style: "background: none; border: none; padding: 0; font-size: 0.875rem; color: #1a1a1a; font-weight: 600; cursor: pointer; font-family: inherit; text-decoration: underline;" %>
          </div>

          <div style="text-align: center; padding-top: 0.5rem;">
            <button type="button" onclick="document.getElementById('delete-zone').style.display='block'; this.style.display='none';"
                    class="font-sans" style="background: none; border: none; padding: 0; font-size: 0.75rem; color: #aaa; cursor: pointer; text-decoration: underline;">
              Advanced
            </button>
          </div>

          <div id="delete-zone" style="display: none; background: white; border-radius: 1.5rem; padding: 1.5rem; border: 2px solid #1a1a1a;">
            <p class="font-sans" style="font-size: 0.8rem; color: #bbb; margin-bottom: 1.25rem; line-height: 1.5;">This will permanently delete your account, all your drawings, and your data. This cannot be undone.</p>
            <p class="font-sans" style="font-size: 0.75rem; color: #aaa; margin-bottom: 0.4rem;">Type DELETE to confirm</p>
            <input type="text" id="delete-confirm-input" placeholder="DELETE" oninput="checkDeleteConfirm(this.value)"
                   class="input-sketchy font-sans" style="width: 100%; margin-bottom: 1rem; font-size: 0.875rem;">
            <%= button_to "Delete my account", account_path, method: :delete,
                  id: "delete-confirm-btn",
                  data: { turbo: false },
                  style: "background: none; border: none; padding: 0; font-size: 0.875rem; color: #ccc; font-weight: 600; cursor: default; pointer-events: none;" %>
          </div>

          <script>
            function checkDeleteConfirm(val) {
              var btn = document.getElementById("delete-confirm-btn");
              if (val === "DELETE") {
                btn.style.color = "#e57373";
                btn.style.pointerEvents = "auto";
                btn.style.cursor = "pointer";
              } else {
                btn.style.color = "#ccc";
                btn.style.pointerEvents = "none";
                btn.style.cursor = "default";
              }
            }
          </script>
        </div>

      <% else %>

        <% if @submissions.any? %>
          <% left_col = @submissions.each_with_index.select { |_, i| i.even? }.map(&:first) %>
          <% right_col = @submissions.each_with_index.select { |_, i| i.odd? }.map(&:first) %>
          <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
            <% [left_col, right_col].each do |col| %>
              <div style="flex: 1; display: flex; flex-direction: column; gap: 0.75rem;">
                <% col.each do |submission| %>
                  <div data-lightbox
                       data-img="<%= url_for(submission.image) %>"
                       data-username="<%= current_user.username %>"
                       data-avatar-url="<%= current_user.avatar_url.to_s %>"
                       data-note="<%= submission.note.to_s %>"
                       data-meta="<%= submission.challenge.date.strftime("%b %-d") %> · <%= submission.challenge.theme.humanize %>"
                       data-share-url="<%= drawing_url(submission) %>"
                       class="img-skeleton"
                       style="position: relative; border-radius: 1rem; overflow: hidden; background: #e8e3db; box-shadow: 0 2px 8px rgba(0,0,0,0.08); cursor: pointer;">
                    <%= image_tag url_for(submission.image), style: "width: 100%; height: auto; display: block;", loading: "lazy", onload: "this.parentElement.classList.remove('img-skeleton')" %>
                    <div class="gallery-hover-overlay"></div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="font-handwritten" style="font-size: 1.1rem; color: #ccc; text-align: center; padding: 4rem 0;">No drawings yet —<br>complete today's challenge!</p>
        <% end %>

      <% end %>

    </div>
  </div>

</div>
