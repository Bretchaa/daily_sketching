<%= render "shared/lightbox" %>

<div class="bg-paper" style="min-height: 100vh; padding: 4rem 2rem 5rem;">
  <div style="max-width: 52rem; margin: 0 auto;">

    <h1 class="font-handwritten" style="font-size: 2rem; color: #1a1a1a; margin-bottom: 0.35rem;">Gallery preview</h1>
    <p class="font-sans" style="font-size: 0.85rem; color: #aaa; margin-bottom: 2rem;">Masonry layout test with mixed orientations</p>

    <div style="columns: 2; column-gap: 0.75rem;">
      <% @preview_images.each do |item| %>
        <div style="break-inside: avoid; margin-bottom: 0.75rem; position: relative; border-radius: 1rem; overflow: hidden; background: #e8e3db; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
          <img src="<%= item[:url] %>" style="width: 100%; height: auto; display: block; cursor: pointer;"
               onclick="openLightbox('<%= item[:url] %>', '<%= j item[:username] %>', '', '')">
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 0.4rem 0.6rem; background: linear-gradient(transparent, rgba(0,0,0,0.6)); display: flex; align-items: center; justify-content: space-between;">
            <p class="font-sans" style="font-size: 0.65rem; color: white; font-weight: 600;"><%= item[:username] %></p>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</div>
